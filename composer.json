{
	"name": "viames/pair_boilerplate",
	"description": "Ready-to-install Pair PHP application with sign-in, permissions, localization, migrations and CRUD generation.",
	"type": "project",
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": "^8.4.1",
		"ext-curl": "*",
		"ext-fileinfo": "*",
		"ext-intl": "*",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-pdo": "*",
		"ext-pdo_mysql": "*",
		"viames/pair": "^4.1.12"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.0"
	},
	"scripts": {
		"post-install-cmd": [
			"php migrate-cli.php"
		],
		"post-update-cmd": [
			"php migrate-cli.php"
		],
		"pair": "php bin/pair",
		"test": "phpunit",
		"upgrade-to-v4": "php vendor/viames/pair/scripts/upgrade-to-v4.php",
		"test:install": "php tests/install.php"
	},
	"autoload": {
		"classmap": [
			"classes/",
			"modules/"
		],
		"exclude-from-classmap": [
			"modules/*/assets/",
			"modules/*/layouts/",
			"modules/*/translations/"
		]
	},
	"license": "MIT",
	"keywords": [
		"pair",
		"php",
		"multilingual",
		"framework",
		"active-record",
		"package-system",
		"runtime-extensions",
		"pagination",
		"router",
		"rest-api",
		"oauth2"
	],
	"homepage": "https://github.com/viames/pair_boilerplate",
	"authors": [
		{
			"name": "Viames Marino",
			"role": "Developer"
		}
	],
	"config": {
		"allow-plugins": {
			"php-http/discovery": true
		}
	},
	"archive": {
		"exclude": [
			"/.DS_Store",
			"/.env",
			"/.env.tmp",
			"/.github",
			"/.git",
			"/.phpunit.cache",
			"/.vscode",
			"/vendor",
			"/temp",
			"/composer.lock"
		]
	}
}
